# ==============================================================================
# PDF Question-Paper RAG System - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Project Directory Paths
# ------------------------------------------------------------------------------
PROJECT_ROOT=/home/harish/dhruv-work/pdf-rag-project
DATA_DIR=data
RAW_PDFS_DIR=data/raw_pdfs
PARSED_DIR=data/parsed
VECTOR_STORE_DIR=data/vector_store
VECTOR_DB_NAME=vector_index.db
CONTEXT_FILE=.agent/context.json
WEB_DIR=web

# ------------------------------------------------------------------------------
# LLM Provider Selection (local | cloud)
# ------------------------------------------------------------------------------
LLM_PROVIDER=local
CLOUD_PROVIDER=google

# ------------------------------------------------------------------------------
# Local LLM Configuration (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL_NAME=qwen3.5:latest

# ------------------------------------------------------------------------------
# Cloud LLM Credentials & Models (Google Gemini & Mistral)
# ------------------------------------------------------------------------------
# Google Gemini API
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash

# Mistral AI API
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL_NAME=mistral-small-latest

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ------------------------------------------------------------------------------
# Backend API & Server Settings
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=dev_secret_key_change_in_prod

# ------------------------------------------------------------------------------
# Deduplication & Retrieval Parameters
# ------------------------------------------------------------------------------
DEDUP_SIMILARITY_THRESHOLD=0.85
DEFAULT_SEARCH_TOP_K=5
